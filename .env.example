# =============================================================================
# AnalyticOS — environment variables
# Copy this file to `.env.local` and fill in the values for local development.
# For production, set the same keys in your hosting provider's env-var UI.
# =============================================================================


# ─── Database ────────────────────────────────────────────────────────────────
# Neon Postgres connection string. Free tier at https://neon.tech.
# Use a dedicated branch per environment (dev / preview / prod).
DATABASE_URL=""


# ─── Auth.js ─────────────────────────────────────────────────────────────────
# Signs sessions AND salts the visitor hash. Generate a fresh 32-byte secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANT: keep this stable in production. Changing it invalidates every
# active session and breaks cross-day visitor-counter continuity.
AUTH_SECRET=""

# Public origin of your app. For local dev: http://localhost:3000.
# In production: your deployed URL (e.g. https://analyticos-nu.vercel.app).
AUTH_URL="http://localhost:3000"

# Required behind a reverse proxy (Vercel, Cloudflare, etc.) so Auth.js infers
# the host from request headers rather than failing. Safe to leave on locally.
AUTH_TRUST_HOST="true"

# Legacy alias kept for compatibility with libraries that still read it.
# Set to the same value as AUTH_URL.
NEXTAUTH_URL="http://localhost:3000"


# ─── App URL ─────────────────────────────────────────────────────────────────
# Used by the tracking snippet generator on the project Settings page.
# IMPORTANT: this is BUILD-TIME INLINED into the client bundle. Changing it
# requires a rebuild — a Vercel env-var change alone won't apply.
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ─── GitHub OAuth (optional) ─────────────────────────────────────────────────
# Credentials login (email/password) works without these.
# To enable GitHub sign-in: create an OAuth App at
#   https://github.com/settings/developers
# Authorization callback URL must be:  <APP_URL>/api/auth/callback/github
# Note: GitHub OAuth Apps allow only ONE callback URL — use separate apps for
# local dev (localhost callback) and production (deployed URL callback).
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""


# ─── Upstash Redis (REST/HTTP) ───────────────────────────────────────────────
# Used for rate limiting, brute-force protection, and dashboard caching.
# Free tier at https://upstash.com. Create a Redis database and copy the
# REST URL + REST token (NOT the redis:// URL — this app uses the HTTP API).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
